{
  "name": "@animama/product-ui",
  "version": "0.23.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./query": {
      "types": "./dist/types/query.d.ts",
      "import": "./dist/query.js"
    },
    "./chat": {
      "types": "./dist/types/chat.d.ts",
      "import": "./dist/chat.js"
    },
    "./audio-tags": {
      "types": "./dist/types/audio-tags.d.ts",
      "import": "./dist/audio-tags.js"
    },
    "./components": {
      "types": "./dist/types/components.d.ts",
      "import": "./dist/components.js"
    },
    "./emotion": {
      "types": "./dist/types/emotion.d.ts",
      "import": "./dist/emotion.js"
    },
    "./anima-profile": {
      "types": "./dist/types/anima-profile.d.ts",
      "import": "./dist/anima-profile.js"
    },
    "./i18n": {
      "types": "./dist/types/i18n.d.ts",
      "import": "./dist/i18n.js"
    },
    "./styles.css": "./dist/styles.css",
    "./theme.css": "./dist/theme.css"
  },
  "scripts": {
    "build": "node ../../scripts/build-typescript-package.mjs src/index.ts src/query.ts src/chat.ts src/audio-tags.ts src/components.ts src/emotion.ts src/anima-profile.ts src/i18n.ts src/theme.css && node build-styles.mjs",
    "check": "tsc -p tsconfig.json --noEmit --emitDeclarationOnly false",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@animama/runtime-contracts": "workspace:*",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tooltip": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.562.0",
    "motion": "^12.38.0",
    "sonner": "^2.0.8",
    "streamdown": "^2.7.1",
    "tailwind-merge": "^3.7.0",
    "use-stick-to-bottom": "^1.1.6"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.90.16",
    "i18next": ">=26.4.2 <27",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-i18next": ">=17.0.15 <18"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "i18next": "26.4.2",
    "postcss": "^8.5.31",
    "react-i18next": "17.0.15",
    "tailwindcss": "^4.3.3"
  }
}
