{
  "name": "animama-frontend-workspace",
  "private": true,
  "license": "AGPL-3.0-only",
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "openapi-ts": "node scripts/generate-openapi-client.mjs",
    "openapi-ts:check": "node scripts/generate-openapi-client.mjs --check",
    "i18n:extract": "cd web && i18next-cli extract && i18next-cli types && cd ../packages/product-ui && i18next-cli extract",
    "i18n:check": "node --test scripts/i18n-catalogs.test.mjs scripts/i18n-check.test.mjs && cd web && i18next-cli extract --ci --dry-run && i18next-cli types --ci && i18next-cli lint -c i18next.lint.config.ts && cd ../packages/product-ui && i18next-cli extract --ci --dry-run && i18next-cli lint -c i18next.lint.config.ts && cd ../.. && node scripts/i18n-catalogs.mjs",
    "i18n:status": "node scripts/i18n-catalogs.mjs --report",
    "generate:background-thumbnails": "node scripts/generate-background-thumbnails.mjs",
    "verify:tts-assets": "node scripts/verify-tts-assets.mjs",
    "generate:particle-vfx-assets": "node scripts/generate-particle-vfx-assets.mjs",
    "typed-content:audit": "bash ../../scripts/audit-typed-content.sh",
    "e2e:list": "node scripts/run-playwright-e2e.mjs --list",
    "e2e:check": "pnpm --filter @animama/runtime-contracts build && pnpm e2e:check:source",
    "e2e:test:unit": "node --experimental-strip-types --test e2e/helpers/*.test.ts",
    "e2e:test": "node scripts/run-playwright-e2e.mjs",
    "e2e:test:fast": "node scripts/run-playwright-e2e.mjs --grep-invert @complete-anima",
    "e2e:test:headed": "node scripts/run-playwright-e2e.mjs --headed",
    "e2e:test:pseudo": "node scripts/run-playwright-e2e.mjs --pseudo-locale",
    "e2e:cleanup": "node scripts/cleanup-playwright-e2e.mjs",
    "e2e:report": "node scripts/show-playwright-report.mjs",
    "e2e:install": "playwright install chromium",
    "web:dev": "pnpm --filter animama-web dev",
    "speech:bench": "node scripts/speech-bench.mjs",
    "web:build": "pnpm --filter animama-web build",
    "web:build:hosted": "pnpm --filter animama-web build:hosted",
    "web:check": "pnpm --filter animama-web check",
    "web:lint": "pnpm --filter animama-web lint",
    "web:test": "pnpm --filter animama-web test",
    "web:test:browser": "pnpm --filter animama-web test:browser",
    "desktop:dev": "pnpm --filter animama-desktop dev",
    "desktop:dev_inspect": "pnpm --filter animama-desktop dev_inspect",
    "desktop:check": "pnpm --filter animama-desktop check",
    "desktop:private-pack": "pnpm --filter animama-desktop runtime:private-pack",
    "desktop:mixamo-motion": "pnpm --filter animama-desktop runtime:mixamo-motion",
    "desktop:build": "pnpm --filter animama-desktop build",
    "desktop:pack": "pnpm --filter animama-desktop run pack",
    "desktop:dist": "pnpm --filter animama-desktop dist",
    "desktop:linux": "pnpm --filter animama-desktop pack:linux",
    "desktop:linux:build": "pnpm --filter animama-desktop build:linux",
    "desktop:mac": "pnpm --filter animama-desktop pack:mac",
    "desktop:mac:build": "pnpm --filter animama-desktop build:mac",
    "desktop:mac:build:run": "pnpm --filter animama-desktop build:mac:run",
    "desktop:mac:launch": "pnpm --filter animama-desktop launch:mac",
    "desktop:mac:package:run": "pnpm --filter animama-desktop pack:mac:run",
    "desktop:mac:run": "pnpm --filter animama-desktop run:mac",
    "desktop:mac:dmg": "pnpm --filter animama-desktop dist:mac",
    "desktop:win": "pnpm --filter animama-desktop pack:win",
    "desktop:win:run": "pnpm --filter animama-desktop run:win",
    "desktop:win:installer": "pnpm --filter animama-desktop installer:win",
    "build": "pnpm --filter animama-web build",
    "check": "pnpm --filter animama-web check && pnpm --filter animama-desktop check && pnpm i18n:check",
    "lint": "pnpm --filter animama-web lint",
    "verify": "pnpm packages:build && pnpm verify:source",
    "verify:source": "pnpm --filter animama-web check:source && pnpm --filter animama-desktop check:source && pnpm i18n:check && pnpm web:lint && pnpm --filter animama-web test:source && pnpm --filter animama-web bundle:source",
    "prettier": "pnpm --filter animama-web prettier && pnpm --filter animama-desktop prettier && pnpm prettier:workspace --write",
    "prettier:check": "pnpm --filter animama-web prettier:check && pnpm --filter animama-desktop prettier:check && pnpm prettier:workspace --check",
    "prettier:workspace": "pnpm --filter animama-web exec prettier --ignore-path ../.prettierignore '../packages/*/{src,tests}/**/*.{ts,tsx,js,mjs}' '../packages/*/*.{js,mjs,ts}' '../e2e/**/*.{ts,mjs}' '../scripts/**/*.{js,mjs,ts}' '../shared/**/*.ts' '../*.{ts,mjs}'",
    "desktop:test:native-input": "node desktop/scripts/native/test-global-input-hook.mjs",
    "desktop:test:vault": "node desktop/scripts/native/test-vault-encryption.mjs",
    "desktop:test:termination": "node desktop/scripts/native/test-runtime-termination.mjs",
    "desktop:test": "pnpm --filter @animama/runtime-contracts build && node desktop/scripts/run-tests.mjs",
    "desktop:runtime:stage": "pnpm --filter animama-desktop runtime:stage",
    "desktop:runtime:audit": "pnpm --filter animama-desktop runtime:audit",
    "desktop:icons": "pnpm --filter animama-desktop icons",
    "desktop:runtime:packs": "pnpm --filter animama-desktop runtime:packs",
    "desktop:dist:mac": "pnpm --filter animama-desktop release:mac",
    "desktop:release:scan": "pnpm --filter animama-desktop release:scan",
    "desktop:dist:windows": "pnpm --filter animama-desktop release:windows",
    "desktop:smoke:mac": "pnpm --filter animama-desktop smoke:mac",
    "desktop:smoke:mac:vm": "pnpm --filter animama-desktop smoke:mac:vm",
    "desktop:smoke:windows": "pnpm --filter animama-desktop smoke:windows",
    "packages:build": "pnpm -r --filter \"./packages/*\" run build",
    "packages:check": "pnpm -r --filter \"./packages/*\" run check",
    "packages:test": "pnpm -r --filter \"./packages/*\" --if-present run test",
    "packages:pack": "node scripts/pack-public-packages.mjs",
    "local:smoke:accountless": "node --experimental-strip-types scripts/smoke-accountless-http.ts",
    "local:verify:accountless": "node --experimental-strip-types scripts/verify-accountless-journey.ts",
    "ci:source": "node scripts/ci-source.mjs",
    "e2e:check:source": "tsc -p tsconfig.e2e.json",
    "desktop:mac:reset": "pnpm --filter animama-desktop reset:mac",
    "desktop:mac:reset:build": "pnpm --filter animama-desktop reset:mac:build",
    "poses:generate": "node scripts/generate-pose-catalog.mjs --write",
    "poses:check": "node scripts/generate-pose-catalog.mjs --check"
  },
  "devDependencies": {
    "@animama/runtime-contracts": "workspace:*",
    "@hey-api/openapi-ts": "^0.90.10",
    "esbuild": "0.27.7",
    "i18next-cli": "1.74.1",
    "knip": "6.43.0",
    "playwright": "1.58.2",
    "sharp": "0.35.5",
    "typescript": "6.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "core-js",
      "esbuild",
      "protobufjs"
    ],
    "patchedDependencies": {
      "@vitejs/plugin-react@6.0.1": "patches/@vitejs__plugin-react@6.0.1.patch",
      "@mochiya/three-liltoon@0.1.9": "patches/@mochiya__three-liltoon@0.1.9.patch"
    }
  }
}
