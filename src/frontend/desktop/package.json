{
  "name": "animama-desktop",
  "private": true,
  "license": "AGPL-3.0-only",
  "version": "0.1.6",
  "description": "Animama private desktop runtime",
  "author": "Animama",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "clean": "node scripts/clean-dist.mjs",
    "dev": "pnpm build && electron .",
    "dev_inspect": "pnpm build && electron --inspect=9229 .",
    "contracts:build": "pnpm --filter @animama/runtime-contracts build",
    "check": "pnpm contracts:build && pnpm check:source",
    "check:source": "tsc -p tsconfig.json --noEmit",
    "build": "pnpm clean && pnpm check && node scripts/build.mjs",
    "pack": "pnpm pack:mac",
    "dist": "pnpm dist:mac",
    "pack:mac": "pnpm build && node scripts/runtime/package-development.mjs --platform darwin --arch arm64",
    "build:mac": "pnpm runtime:stage -- --platform darwin --arch arm64 && pnpm runtime:audit -- --platform darwin --arch arm64 && pnpm pack:mac",
    "build:mac:run": "pnpm build:mac && pnpm launch:mac",
    "launch:mac": "open release/mac/Animama.app",
    "pack:mac:run": "pnpm pack:mac && pnpm launch:mac",
    "run:mac": "pnpm pack:mac:run",
    "dist:mac": "node scripts/runtime/release-gate.mjs mac",
    "pack:win": "pnpm build && node scripts/runtime/package-development.mjs --platform win32 --arch x64",
    "run:win": "pnpm pack:win && node scripts/run-windows-app.mjs",
    "installer:win": "pnpm build && node scripts/runtime/package-development.mjs --platform win32 --arch x64 --installer",
    "dist:win": "node scripts/runtime/release-gate.mjs windows",
    "pack:linux": "pnpm build && node scripts/runtime/package-development.mjs --platform linux --arch x64",
    "build:linux": "pnpm runtime:stage -- --platform linux --arch x64 && pnpm runtime:audit -- --platform linux --arch x64 && pnpm pack:linux",
    "prettier": "prettier --config ../prettier.config.mjs --ignore-path ../.prettierignore --write 'src/**/*.{ts,cts,tsx,js,jsx,json,md}' 'scripts/**/*.{js,mjs,ts,cts}' '*.{js,mjs,ts,json,md,yml,yaml}' 'runtime/**/*.json' 'tests/**/*.{ts,mjs}'",
    "prettier:check": "prettier --config ../prettier.config.mjs --ignore-path ../.prettierignore --check 'src/**/*.{ts,cts,tsx,js,jsx,json,md}' 'scripts/**/*.{js,mjs,ts,cts}' '*.{js,mjs,ts,json,md,yml,yaml}' 'runtime/**/*.json' 'tests/**/*.{ts,mjs}'",
    "test": "pnpm contracts:build && vitest run",
    "runtime:stage": "node scripts/runtime/stage.mjs",
    "runtime:audit": "node scripts/runtime/audit.mjs",
    "icons": "node scripts/runtime/icon.mjs",
    "runtime:packs": "node scripts/runtime/feature-packs.mjs",
    "runtime:private-pack": "node scripts/runtime/private-pack-cli.mjs",
    "runtime:mixamo-motion": "node scripts/runtime/private-pack-cli.mjs --pack mixamo-motion",
    "release:mac": "node scripts/runtime/release-gate.mjs mac",
    "release:scan": "node scripts/runtime/scan-release-candidate.mjs",
    "models:stage": "node scripts/runtime/publish-models-r2.mjs stage",
    "models:publish": "node scripts/runtime/publish-models-r2.mjs publish",
    "release:windows": "node scripts/runtime/release-gate.mjs windows",
    "smoke:mac": "node scripts/runtime/release-gate.mjs smoke-mac",
    "smoke:mac:vm": "bash scripts/vm/smoke-macos-vm.sh",
    "smoke:windows": "node scripts/runtime/release-gate.mjs smoke-windows",
    "reset:mac": "node scripts/reset-macos-profile.mjs",
    "reset:mac:build": "pnpm build:mac && pnpm reset:mac"
  },
  "packageManager": "pnpm@10.33.0",
  "dependencies": {
    "electron-updater": "6.8.11",
    "tar-stream": "3.2.2"
  },
  "devDependencies": {
    "@animama/runtime-contracts": "workspace:*",
    "@electron/asar": "3.4.1",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@types/node": "^24.19.2",
    "@types/tar-stream": "3.1.5",
    "aws4fetch": "1.0.20",
    "electron": "45.3.1",
    "electron-builder": "26.18.0",
    "esbuild": "0.27.7",
    "node-gyp": "12.4.0",
    "prettier": "3.8.3",
    "prettier-plugin-tailwindcss": "0.7.3",
    "resedit": "1.7.2",
    "typescript": "~6.0.3",
    "vitest": "4.1.12"
  }
}
