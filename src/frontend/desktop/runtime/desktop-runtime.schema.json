{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://animama.invalid/schemas/desktop-runtime/2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "app_version",
    "build_id",
    "platform",
    "architecture",
    "minimum_os",
    "postgresql",
    "alembic_head",
    "local_http_schema_version",
    "core_content_inventory_id",
    "pack_catalog_id",
    "database_schema_sha256",
    "files"
  ],
  "properties": {
    "schema": { "const": "animama-desktop-runtime/2" },
    "app_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "build_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "platform": { "enum": ["darwin", "win32", "linux"] },
    "architecture": { "enum": ["arm64", "x64"] },
    "minimum_os": { "type": "string", "minLength": 1 },
    "postgresql": {
      "type": "object",
      "additionalProperties": false,
      "required": ["major", "version", "pgvector"],
      "properties": {
        "major": { "const": 16 },
        "version": { "type": "string", "pattern": "^16\\.[0-9]+$" },
        "pgvector": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      }
    },
    "alembic_head": { "type": "string", "minLength": 1 },
    "local_http_schema_version": { "const": 1 },
    "core_content_inventory_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "pack_catalog_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "database_schema_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "size_bytes",
          "sha256",
          "mode",
          "component",
          "critical"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*[\\\\:]).+$"
          },
          "size_bytes": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "mode": { "enum": ["0644", "0755"] },
          "component": {
            "enum": [
              "web_javascript",
              "browser_runtimes",
              "starter_content",
              "frozen_backend",
              "postgresql",
              "licenses",
              "package_overhead"
            ]
          },
          "critical": { "type": "boolean" }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "platform": { "const": "darwin" } } },
      "then": { "properties": { "architecture": { "const": "arm64" } } }
    },
    {
      "if": { "properties": { "platform": { "const": "win32" } } },
      "then": { "properties": { "architecture": { "const": "x64" } } }
    },
    {
      "if": { "properties": { "platform": { "const": "linux" } } },
      "then": { "properties": { "architecture": { "const": "x64" } } }
    }
  ]
}
